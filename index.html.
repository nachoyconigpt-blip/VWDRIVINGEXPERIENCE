    <div class="pointer" aria-hidden="true"></div>
    <svg id="wheel" class="wheel" viewBox="0 0 100 100" aria-label="Ruleta de premios"></svg>
    <button id="spin" class="hub" aria-label="Girar ruleta">
      <img src="data:image/png;base64," alt="Volkswagen">
    </button>
  </div>

  <img class="footer" src="data:image/png;base64," alt="Lestido">
  <div class="hint">Tocá el centro para girar</div>
</main>

<button id="full" class="full" aria-label="Pantalla completa">⛶</button>

<dialog id="result">
