const units = 1000;
const svg = document.getElementById('wheel');
const ns = 'http://www.w3.org/2000/svg';
const blue = '#001E50', lightBlue = '#A9C7E8';
const step = 360 / prizes.length, center=50, radius=48;
function polar(r,deg){const a=(deg-90)*Math.PI/180;return {x:center+r*Math.cos(a),y:center+r*Math.sin(a)};}
function add(tag,attrs,parent=svg){const el=document.createElementNS(ns,tag);for(const [k,v] of Object.entries(attrs))el.setAttribute(k,v);parent.appendChild(el);return el;}
prizes.forEach((lines,i)=>{
 const start=i*step,end=start+step, a=polar(radius,start),b=polar(radius,end);
 add('path',{d:`M 50 50 L ${a.x} ${a.y} A ${radius} ${radius} 0 0 1 ${b.x} ${b.y} Z`,fill:i%2?blue:'#FFFFFF'});
 const mid=start+step/2, p=polar(30,mid);
 // Radial labels: avoid hub and outer rim; flip the left half for readability.
 let angle=mid-90;if(angle>90)angle-=180;
 const group=add('g',{transform:`translate(${p.x} ${p.y}) rotate(${angle})`,fill:i%2?'#FFFFFF':blue});
 lines.forEach((line,j)=>{
   const item=outlines[line],scale=Math.min(3.8/units,30/item.width);
   const baseline=(j-(lines.length-1)/2)*4.3+1.3;
   const t=add('g',{transform:`translate(${-item.width*scale/2} ${baseline}) scale(${scale} ${-scale})`},group);
   t.innerHTML=item.svg;
 });
});
add('circle',{cx:50,cy:50,r:48.6,fill:'none',stroke:blue,'stroke-width':2.4});
const spin=document.getElementById('spin'),dialog=document.getElementById('result'),resultText=document.getElementById('resultText');
let rotation=0,busy=false;
function choosePrizeIndex(){let n=Math.random()*100;for(let i=0;i<weights.length;i++){n-=weights[i];if(n<0)return i;}return weights.length-1;}
spin.addEventListener('click',()=>{
 if(busy)return;busy=true;spin.disabled=true;
 const index=choosePrizeIndex(), target=360-(index*step+step/2), turns=6+Math.floor(Math.random()*2);
 rotation+=turns*360+((target-rotation%360+360)%360);
 const duration=window.matchMedia('(prefers-reduced-motion: reduce)').matches?100:5600;
 let completed=false,timer;
 const done=()=>{if(completed)return;completed=true;clearTimeout(timer);svg.removeEventListener('transitionend',done);resultText.textContent=prizes[index].join(' ');dialog.showModal();busy=false;spin.disabled=false;};
 svg.addEventListener('transitionend',done,{once:true});
 svg.style.transition=`transform ${duration}ms cubic-bezier(.12,.85,.15,1)`;
 svg.style.transform=`rotate(${rotation}deg)`;
 timer=setTimeout(done,duration+200);
});
document.getElementById('closeResult').addEventListener('click',()=>dialog.close());
document.getElementById('full').addEventListener('click',async()=>{try{if(document.fullscreenElement)await document.exitFullscreen();else if(document.documentElement.requestFullscreen)await document.documentElement.requestFullscreen();}catch(e){}});
</script>

