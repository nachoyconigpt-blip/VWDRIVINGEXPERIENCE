<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>VW Driving Experience | Ruleta</title>
<style>
  
  * { box-sizing: border-box; }
  html, body { height: 100%; }
  body {
    margin: 0;
    background: #FFFFFF;
    color: #001E50;
    font-family: 'VW Head Office', Arial, Helvetica, sans-serif;
    overflow-x: hidden;
  }
  main {
    width: min(100%, 700px, 59vh);
    min-width: min(100%, 320px);
    min-height: 100dvh;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 2vh 0 2.2vh;
  }
  .brand {
    width: 95%;
    text-align: center;
    margin-bottom: 2.4vh;
    color: #001E50;
    text-transform: uppercase;
    line-height: .88;
    letter-spacing: -0.03em;
    user-select:none;
  }
  .brand .line1 {
    font-size: clamp(42px, 8vh, 88px);
    font-weight: 700;
    white-space: nowrap;
  }
  .brand .line2 {
    margin-top: .18em;
    font-size: clamp(42px, 8vh, 88px);
    font-weight: 700;
    white-space: nowrap;
  }
  .stage {
    width: 95%;
    position: relative;
    aspect-ratio: 1;
    isolation: isolate;
  }
  .wheel {
    width: 100%;
    height: 100%;
    display: block;
    transform: rotate(0deg);
    will-change: transform;
  }
  .pointer {
    position: absolute;
    top: -2.3%;
    left: 50%;
    transform: translateX(-50%);
    width: 6.8%;
    height: 8.2%;
    background: #001E50;
    clip-path: polygon(50% 100%, 0 0, 100% 0);
    z-index: 3;
    filter: drop-shadow(0 1px 0 rgba(0,0,0,.06));
  }
  .hub {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    width: 23%;
    aspect-ratio: 1;
    border: clamp(3px,.55vw,5px) solid #001E50;
    border-radius: 50%;
    padding: 2%;
    background: white;
    cursor: pointer;
    overflow: hidden;
    z-index: 2;
    box-shadow: 0 5px 18px rgba(0,30,80,.14);
  }
  .hub img { width: 100%; height: 100%; object-fit: contain; display:block; }
  .hub:focus-visible { outline: 3px solid #001E50; outline-offset: 4px; }
  .hub:disabled { cursor: default; opacity: 1; }
  .footer {
    width: 38%;
    display:block;
    margin: 3.1vh auto .7vh;
  }
  .hint {
    font-size: clamp(11px, 1.45vh, 16px);
    color: #60708a;
    text-align: center;
    margin: .7vh 0 0;
    letter-spacing: .04em;
    text-transform: uppercase;
  }
  .full {
    position: fixed;
    right: 12px;
    bottom: 12px;
    border: 1px solid rgba(0,30,80,.22);
    background: #fff;
    color: #001E50;
    border-radius: 8px;
    padding: 9px 11px;
    cursor: pointer;
    font-size: 17px;
    box-shadow: 0 4px 14px rgba(0,30,80,.08);
  }
  dialog {
    width: min(90vw, 540px);
    background: white;
    color: #001E50;
    border: 2px solid #001E50;
    border-radius: 16px;
    text-align: center;
    padding: 34px 24px 26px;
    box-shadow: 0 30px 90px rgba(0,0,0,.16);
  }
  dialog::backdrop { background: rgba(0,0,0,.28); }
  dialog h2 {
    font-size: clamp(28px, 5vw, 46px);
    margin: 0 0 14px;
    line-height: .95;
    letter-spacing: -.03em;
    text-transform: uppercase;
  }
  dialog p {
    margin: 0 0 22px;
    font-size: clamp(24px, 4vw, 38px);
    line-height: 1.1;
    font-weight: 700;
    text-transform: uppercase;
  }
  dialog button {
    background: #001E50;
    color: white;
    border: 0;
    padding: 14px 26px;
    font-size: 16px;
    font-family: inherit;
    text-transform: uppercase;
    border-radius: 999px;
    cursor: pointer;
  }
  @media (max-aspect-ratio: 3/4) {
    main { width: min(100%, 57vh); min-width: 0; }
    .brand .line1, .brand .line2 { white-space: normal; }
  }
  @media (prefers-reduced-motion: reduce) {
    .wheel { will-change: auto; }
  }
.brand{width:85%;margin-bottom:4vh}.stage{width:96%}
</style>
</head>
